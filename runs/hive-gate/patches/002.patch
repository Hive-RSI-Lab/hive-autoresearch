# again, -trimpath, now its standard library is in the build cache (try 1 compiled it there once: 394 MB of plain writes)
diff --git a/internal/gate/gate_test.go b/internal/gate/gate_test.go
index cefe03eda..178c3359b 100644
--- a/internal/gate/gate_test.go
+++ b/internal/gate/gate_test.go
@@ -775,6 +775,13 @@ func TestMain(m *testing.M) {
 			testGoCache = f[1]
 		}
 	}
+	// The sides' builds leave out where each checkout is, so a package that
+	// is the same on two sides (or in two runs of a test) is the same test
+	// binary, and go test reuses its passed result instead of linking it
+	// again. A GOFLAGS already set is kept.
+	if os.Getenv("GOFLAGS") == "" {
+		os.Setenv("GOFLAGS", "-trimpath")
+	}
 	dir, _ := os.MkdirTemp("", "gate-test-config-")
 	os.Setenv("XDG_CONFIG_HOME", dir)
 	os.Setenv("HOME", dir)
