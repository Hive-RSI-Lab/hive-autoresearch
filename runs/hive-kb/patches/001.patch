 func TestSeedingReportsAFailedCommit(t *testing.T) {
 	ws, c, mods := freshWorkspace(t)
 	if _, err := core.Git("", "init", "-q", "-b", "main", ws.KB()); err != nil {
 		t.Fatal(err)
