# journal: parse the fixed envelope Append writes ({seq,at,kind,data}) directly in Replay/Since/OpenJournal, leave data raw for Decode; json.Unmarshal fallback for any other line
diff --git a/internal/core/journal.go b/internal/core/journal.go
index cda3a2532..a8e4bc18e 100644
--- a/internal/core/journal.go
+++ b/internal/core/journal.go
@@ -6,6 +6,7 @@ package core
 
 import (
 	"bufio"
+	"bytes"
 	"encoding/json"
 	"errors"
 	"io"
@@ -38,6 +39,60 @@ type Event struct {
 	Data json.RawMessage `json:"data,omitempty"`
 }
 
+// parseEvent reads one journal line. Append writes every line as
+// {"seq":N,"at":"T","kind":"K","data":D}, and a start replays the whole
+// journal a dozen times, so that layout is read directly, leaving D for
+// Decode to check: json.Unmarshal of every line spent most of a start's CPU
+// (13 s of it on 300 MB). Any other line goes through json.Unmarshal.
+func parseEvent(raw []byte) (Event, bool) {
+	var e Event
+	if fastEvent(raw, &e) {
+		return e, true
+	}
+	e = Event{}
+	return e, json.Unmarshal(raw, &e) == nil && e.Kind != ""
+}
+
+func fastEvent(raw []byte, e *Event) bool {
+	rest, ok := bytes.CutPrefix(raw, []byte(`{"seq":`))
+	if !ok {
+		return false
+	}
+	i := 0
+	for i < len(rest) && i < 19 && rest[i] >= '0' && rest[i] <= '9' {
+		e.Seq = e.Seq*10 + int64(rest[i]-'0')
+		i++
+	}
+	if rest, ok = bytes.CutPrefix(rest[i:], []byte(`,"at":"`)); i == 0 || !ok {
+		return false
+	}
+	i = bytes.IndexByte(rest, '"')
+	if i < 0 || bytes.IndexByte(rest[:i], '\\') >= 0 {
+		return false
+	}
+	at, err := time.Parse(time.RFC3339Nano, string(rest[:i]))
+	if err != nil {
+		return false
+	}
+	e.At = at
+	if rest, ok = bytes.CutPrefix(rest[i+1:], []byte(`,"kind":"`)); !ok {
+		return false
+	}
+	i = bytes.IndexByte(rest, '"')
+	if i <= 0 || bytes.IndexByte(rest[:i], '\\') >= 0 {
+		return false
+	}
+	e.Kind = string(rest[:i])
+	switch rest = rest[i+1:]; {
+	case string(rest) == "}":
+	case bytes.HasPrefix(rest, []byte(`,"data":`)) && bytes.HasSuffix(rest, []byte("}")):
+		e.Data = json.RawMessage(rest[len(`,"data":`) : len(rest)-1])
+	default:
+		return false
+	}
+	return true
+}
+
 // Decode unmarshals the event payload into v.
 func (e Event) Decode(v any) error { return json.Unmarshal(e.Data, v) }
 
