+func (j *Journal) Replay(fn func(Event)) error { return j.ReplayExcept(fn) }
+
+// ReplayExcept is Replay without the events of the kinds named, which are
+// passed over before they are copied out. Most of the journal is two kinds
+// fn rarely wants (task.saved 51% of its bytes, run.created 41% on
+// 2026-10-30), and a start replays it once per module.
+func (j *Journal) ReplayExcept(fn func(Event), skip ...string) error {
+	_, err := scan(j.path, 0, func(_ int64, raw []byte) {
+		if e, ok := parseEvent(raw, skip); ok {
 			fn(e)
 		}
 	})
+	return err
 }
 
 // Since returns events with Seq > after, reading from the last mark before
@@ -271,8 +287,8 @@ func (j *Journal) Since(after int64) []Event {
 	}
 	j.mu.Unlock()
 	var out []Event
-	_, _ = readFrom(j.path, from, func(_ int64, raw []byte) {
-		if e, ok := parseEvent(raw); ok && e.Seq > after {
+	_, _ = scan(j.path, from, func(_ int64, raw []byte) {
+		if e, ok := parseEvent(raw, nil); ok && e.Seq > after {
 			out = append(out, e)
 		}
 	})
